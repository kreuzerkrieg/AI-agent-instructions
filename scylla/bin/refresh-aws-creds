#!/usr/bin/env python3
"""
Refresh ScyllaDB AWS credentials via gimme-aws-creds + Okta TOTP.

Usage:  refresh-aws-creds
        refresh-aws-creds <totp-code>   # pass code as argument (for agent use)

Everything is automated except the 6-digit TOTP code from Google Authenticator.
Password is read from ~/.config/gimme-aws-creds-pass (chmod 600).
"""

import sys
import os
import shutil
import pexpect

PASS_FILE = os.path.expanduser("~/.config/gimme-aws-creds-pass")
# Generous: a cold uvx cache has to resolve and download the environment before
# the first prompt appears. This is a ceiling on waiting, not a fixed delay.
TIMEOUT = 120
GIMME_PIN = "gimme-aws-creds==2.8.2"

# Locate the gimme-aws-creds launcher script. Every copy on disk carries a
# shebang pointing at an interpreter that cannot import gimme_aws_creds (the
# package lives in the pyenv user site-packages), so the launcher is never
# executed directly -- see run_gimme() below.
_FALLBACKS = (
    "~/Development/scylladb/venv/bin/gimme-aws-creds",
    "~/Development/scylladb_1/venv/bin/gimme-aws-creds",
)


def find_gimme():
    found = shutil.which("gimme-aws-creds")
    if found:
        return found
    for candidate in _FALLBACKS:
        candidate = os.path.expanduser(candidate)
        if os.access(candidate, os.X_OK):
            return candidate
    sys.exit("gimme-aws-creds not found on PATH or in any known venv")


def run_gimme():
    """Spawn gimme-aws-creds, preferring an isolated uvx environment.

    The copy installed in the pyenv user site-packages is unusable: it pulls in
    whatever version of the okta SDK happens to be installed there, and
    gimme-aws-creds 2.8.2 needs okta<3.0.0 (3.0.0 renamed APIClient to
    ApiClient, so main.py fails to import). uvx resolves the pinned dependency
    set in a throwaway environment, which keeps this working regardless of what
    the shared site-packages contains.

    The local launcher is kept as a fallback, spawned under *this* interpreter
    rather than executed directly -- its own shebang points at a python that
    cannot import the package at all.
    """
    uvx = shutil.which("uvx")
    if uvx:
        return pexpect.spawn(uvx, ["--from", GIMME_PIN, "gimme-aws-creds"], encoding="utf-8", timeout=TIMEOUT)
    return pexpect.spawn(sys.executable, [find_gimme()], encoding="utf-8", timeout=TIMEOUT)


def get_password():
    with open(PASS_FILE) as f:
        return f.read().strip()


def main():
    totp = sys.argv[1] if len(sys.argv) > 1 else None
    password = get_password()

    child = run_gimme()
    child.logfile_read = sys.stdout  # echo output to terminal

    # --- password prompt (keyring unavailable in PTY context) ---
    child.expect(r"Okta Password for [^:]+:\s*")
    child.sendline(password)

    # --- "save password in keyring?" --- send y to keep keyring up to date
    child.expect(r"save this password in the keyring\? \(y/N\)\s*")
    child.sendline("y")

    # --- factor selection: always 0 (Google TOTP) ---
    child.expect(r"Selection:\s*")
    child.sendline("0")

    # --- TOTP code: the only human input needed ---
    child.expect(r"Enter verification code:\s*")
    if totp is None:
        sys.stdout.write("\n>>> Enter Google Authenticator code: ")
        sys.stdout.flush()
        totp = input()
    child.sendline(totp)

    # --- role selection: always 0 (DevOpsAccessRole) ---
    child.expect(r"Selections \(comma separated\):\s*")
    child.sendline("0")

    # --- wait for finish ---
    child.expect(pexpect.EOF, timeout=60)
    print()


if __name__ == "__main__":
    main()
